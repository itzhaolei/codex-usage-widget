<Window x:Class="QuotaBubble.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="330" SizeToContent="Height" MinHeight="287"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="True" Title="Quota Bubble"
        Icon="/Assets/icon.png" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="ControlButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#DDE6EA"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="InfoIconPath" TargetType="Path">
      <Setter Property="Fill" Value="Transparent"/><Setter Property="Stroke" Value="#AEB9BF"/>
      <Setter Property="StrokeThickness" Value="1.35"/><Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <VisualBrush x:Key="FiveHourDotBrush" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute">
      <VisualBrush.Visual><Ellipse Width="1.1" Height="1.1" Fill="#00C229"/></VisualBrush.Visual>
    </VisualBrush>
    <VisualBrush x:Key="WeeklyDotBrush" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute">
      <VisualBrush.Visual><Ellipse Width="1.1" Height="1.1" Fill="#00C229"/></VisualBrush.Visual>
    </VisualBrush>
  </Window.Resources>

  <Border x:Name="Root" CornerRadius="12" Background="#EB111D18" BorderBrush="#596A6F70" BorderThickness="1" Padding="12,10,12,9">
    <Grid>
      <StackPanel>
        <Grid Height="28">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="PlanBadge" CornerRadius="2" Margin="5,0,0,0" Padding="4,0" Height="16" MinHeight="16" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="PlanText" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="None"/>
            </Border>
          </StackPanel>
          <Border x:Name="Capsule" Grid.Column="1" Width="111" Height="28" CornerRadius="14" BorderBrush="#587282" BorderThickness="1" Background="#263D4A">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="ThemeButton" Grid.Column="0" Style="{StaticResource ControlButton}" ToolTip="Theme">
                <Grid Width="14" Height="14">
                  <Grid x:Name="SunIcon">
                    <Ellipse Width="5" Height="5" Stroke="{Binding Foreground, ElementName=ThemeButton}" StrokeThickness="1.35"/>
                    <Path Stroke="{Binding Foreground, ElementName=ThemeButton}" StrokeThickness="1.25" StrokeStartLineCap="Round"
                          Data="M7,0.5 L7,2 M7,12 L7,13.5 M0.5,7 L2,7 M12,7 L13.5,7 M2.4,2.4 L3.45,3.45 M10.55,10.55 L11.6,11.6 M11.6,2.4 L10.55,3.45 M3.45,10.55 L2.4,11.6"/>
                  </Grid>
                  <Path x:Name="MoonIcon" Visibility="Collapsed" Fill="{Binding Foreground, ElementName=ThemeButton}"
                        Data="M11.8,9.4 C10.9,9.9 9.9,10.2 8.8,10.2 C5.9,10.2 3.6,7.9 3.6,5 C3.6,3.9 3.9,2.9 4.5,2 C2.4,2.8 1,4.8 1,7.1 C1,10.4 3.7,13 6.9,13 C9.2,13 11.2,11.6 12,9.5 Z"/>
                </Grid>
              </Button>
              <Border Grid.Column="1" HorizontalAlignment="Left" Width="1" Height="16" Background="#557A858B"/>
              <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource ControlButton}" ToolTip="Pin">
                <Viewbox Width="13" Height="13"><Path Fill="{Binding Foreground, ElementName=PinButton}" Data="M4,1 L12,1 L10.3,5 L12,7 L8.8,7 L8,14 L7.2,7 L4,7 L5.7,5 Z"/></Viewbox>
              </Button>
              <Border Grid.Column="2" HorizontalAlignment="Left" Width="1" Height="16" Background="#557A858B"/>
              <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource ControlButton}" ToolTip="Close">
                <Viewbox Width="12" Height="12"><Path Stroke="{Binding Foreground, ElementName=CloseButton}" StrokeThickness="1.5" StrokeStartLineCap="Round" Data="M2,2 L10,10 M10,2 L2,10"/></Viewbox>
              </Button>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="FiveHourQuotaPanel" Margin="0,11,0,0" Height="55" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="5h" FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="|" Margin="7,0" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="#AEB9BF" VerticalAlignment="Center"/>
            <TextBlock x:Name="FiveHourResetText" FontSize="10" FontFamily="Consolas" Foreground="#AEB9BF" TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center"/>
            <TextBlock Text="|" Margin="7,0" FontSize="8" FontFamily="Consolas" Foreground="#84FFFFFF" VerticalAlignment="Center"/>
            <TextBlock x:Name="FiveHourResetDateText" FontSize="8" Foreground="#84FFFFFF" FontFamily="Consolas" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid Margin="0,20,0,0" Width="231" Height="35" HorizontalAlignment="Left" ClipToBounds="True">
            <Rectangle x:Name="FiveHourProgressPattern" Fill="{StaticResource FiveHourDotBrush}" Opacity="0.78"/>
            <Rectangle x:Name="FiveHourProgressFill" Width="0" HorizontalAlignment="Left" Fill="#00C229"/>
            <Canvas IsHitTestVisible="False">
              <Border Canvas.Left="46" Width="1" Height="35" Background="#71006510"/><Border Canvas.Left="92" Width="1" Height="35" Background="#71006510"/>
              <Border Canvas.Left="138" Width="1" Height="35" Background="#71006510"/><Border Canvas.Left="184" Width="1" Height="35" Background="#71006510"/>
            </Canvas>
          </Grid>
          <TextBlock x:Name="FiveHourPercentText" Margin="243,28,0,0" Width="38" FontSize="11" FontFamily="Consolas" Foreground="White"/>
        </Grid>

        <StackPanel Margin="0,11,0,0">
          <Grid Height="55">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
              <TextBlock x:Name="WeekText" FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="|" Margin="7,0" FontSize="8" FontFamily="Consolas" FontWeight="Bold" Foreground="#AEB9BF" VerticalAlignment="Center"/>
              <TextBlock x:Name="ResetText" FontSize="10" FontFamily="Consolas" Foreground="#AEB9BF" TextTrimming="CharacterEllipsis" MaxWidth="118" VerticalAlignment="Center"/>
              <TextBlock Text="|" Margin="7,0" FontSize="8" FontFamily="Consolas" Foreground="#84FFFFFF" VerticalAlignment="Center"/>
              <TextBlock x:Name="ResetDateText" FontSize="8" Foreground="#84FFFFFF" FontFamily="Consolas" VerticalAlignment="Center"/>
              <TextBlock Text="|" Margin="7,0" FontSize="8" FontFamily="Consolas" Foreground="#84FFFFFF" VerticalAlignment="Center"/>
              <TextBlock x:Name="ResetWeekdayText" FontSize="8" Foreground="#84FFFFFF" FontFamily="Consolas" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Margin="0,20,0,0" Width="231" Height="35" HorizontalAlignment="Left" ClipToBounds="True">
              <Rectangle x:Name="ProgressPattern" Fill="{StaticResource WeeklyDotBrush}" Opacity="0.78"/>
              <Rectangle x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" Fill="#00C229"/>
              <Canvas IsHitTestVisible="False">
                <Border Canvas.Left="46" Width="1" Height="35" Background="#71006510"/><Border Canvas.Left="92" Width="1" Height="35" Background="#71006510"/>
                <Border Canvas.Left="138" Width="1" Height="35" Background="#71006510"/><Border Canvas.Left="184" Width="1" Height="35" Background="#71006510"/>
              </Canvas>
            </Grid>
            <TextBlock x:Name="PercentText" Margin="243,28,0,0" Width="38" FontSize="11" FontFamily="Consolas" Foreground="White"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Height="15" Margin="0,4,0,0">
            <Button x:Name="PaletteButton0" Width="15" Height="15" Style="{StaticResource ControlButton}" ToolTip="Green"><Border x:Name="PaletteSwatch0" Width="12" Height="12" CornerRadius="3" Background="#00C229"/></Button>
            <Button x:Name="PaletteButton1" Width="15" Height="15" Margin="4,0,0,0" Style="{StaticResource ControlButton}" ToolTip="Teal"><Border x:Name="PaletteSwatch1" Width="12" Height="12" CornerRadius="3" Background="#00A396"/></Button>
            <Button x:Name="PaletteButton2" Width="15" Height="15" Margin="4,0,0,0" Style="{StaticResource ControlButton}" ToolTip="Blue"><Border x:Name="PaletteSwatch2" Width="12" Height="12" CornerRadius="3" Background="#1F85FF"/></Button>
            <Button x:Name="PaletteButton3" Width="15" Height="15" Margin="4,0,0,0" Style="{StaticResource ControlButton}" ToolTip="Purple"><Border x:Name="PaletteSwatch3" Width="12" Height="12" CornerRadius="3" Background="#9E57FF"/></Button>
            <Button x:Name="PaletteButton4" Width="15" Height="15" Margin="4,0,0,0" Style="{StaticResource ControlButton}" ToolTip="Gold"><Border x:Name="PaletteSwatch4" Width="12" Height="12" CornerRadius="3" Background="#C7A359"/></Button>
          </StackPanel>
        </StackPanel>

        <ItemsControl x:Name="ResetItems" Margin="0,13,0,0" Visibility="Collapsed">
          <ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Orientation="Horizontal" Height="18">
              <Ellipse Width="7" Height="7" Fill="{Binding Brush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Text}" FontSize="10" FontFamily="Consolas" Foreground="{Binding Foreground}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="MetricCards" Width="272" Height="47" HorizontalAlignment="Left" Margin="0,15,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="131"/><ColumnDefinition Width="10"/><ColumnDefinition Width="131"/></Grid.ColumnDefinitions>
          <Border x:Name="BalanceCard" Grid.Column="0" Height="47" CornerRadius="9" Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="4,7,4,5">
            <StackPanel>
              <TextBlock x:Name="BalanceTitle" Height="11" Foreground="#B8C2C7" FontSize="9" FontFamily="Consolas" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock x:Name="BalanceValue" Foreground="White" FontSize="13" FontFamily="Consolas" FontWeight="SemiBold" TextAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="ResetCard" Grid.Column="2" Height="47" CornerRadius="9" Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="4,7,4,5">
            <StackPanel>
              <TextBlock x:Name="ResetTitle" Height="11" Foreground="#B8C2C7" FontSize="9" FontFamily="Consolas" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock x:Name="ResetValue" Foreground="White" FontSize="13" FontFamily="Consolas" FontWeight="SemiBold" TextAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Margin="0,7,0,0">
          <Grid Height="17" Margin="0,0,0,1">
            <Viewbox Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="AccountIcon" Style="{StaticResource InfoIconPath}" Data="M8,8 A3,3 0 1 0 8,2 A3,3 0 1 0 8,8 M2,15 C2.4,11.6 4.5,10 8,10 C11.5,10 13.6,11.6 14,15"/></Viewbox>
            <TextBlock x:Name="AccountText" Margin="20,0,0,0" FontSize="10" FontFamily="Consolas" Foreground="#AEB9BF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Grid>
          <Grid Height="17" Margin="0,0,0,1">
            <Viewbox Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="SubscriptionIcon" Style="{StaticResource InfoIconPath}" Data="M2,3.5 L14,3.5 L14,14 L2,14 Z M5,1.5 L5,5 M11,1.5 L11,5 M2,7 L14,7 M8,9 L8,11 L10,12"/></Viewbox>
            <TextBlock x:Name="SubscriptionText" Margin="20,0,0,0" FontSize="10" FontFamily="Consolas" Foreground="#AEB9BF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Grid>
          <Grid Height="17" Margin="0,0,0,1">
            <Viewbox Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="StorageIcon" Style="{StaticResource InfoIconPath}" Data="M2,3 L14,3 L15,7 L15,13 L1,13 L1,7 Z M1,7 L15,7 M4,10 L5,10"/></Viewbox>
            <TextBlock x:Name="StorageText" Margin="20,0,0,0" FontSize="10" FontFamily="Consolas" Foreground="#00C229" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Grid>
          <Grid Height="17">
            <Viewbox Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center"><Path x:Name="MemoryIcon" Style="{StaticResource InfoIconPath}" Data="M3,3 L13,3 L13,13 L3,13 Z M6,6 L10,6 L10,10 L6,10 Z M5,1 L5,3 M8,1 L8,3 M11,1 L11,3 M5,13 L5,15 M8,13 L8,15 M11,13 L11,15 M1,5 L3,5 M1,8 L3,8 M1,11 L3,11 M13,5 L15,5 M13,8 L15,8 M13,11 L15,11"/></Viewbox>
            <TextBlock x:Name="MemoryText" Margin="20,0,0,0" FontSize="10" FontFamily="Consolas" Foreground="#00C229" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
        <Border Height="13"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Ellipse x:Name="UpdateDot" Width="4" Height="4" Fill="#FF3333" Margin="0,0,4,2" Visibility="Collapsed"/>
        <TextBlock x:Name="VersionText" FontSize="9" FontWeight="Light" FontFamily="Consolas" Foreground="#AEB9BF"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
